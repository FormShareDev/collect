<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms"
        xmlns:h="http://www.w3.org/1999/xhtml"
        xmlns:jr="http://openrosa.org/javarosa"
        xmlns:orx="http://openrosa.org/xforms">
    <h:head>
        <h:title>Parity Edge Text</h:title>
        <model>
            <instance>
                <data id="parity_edge_text" orx:version="1">
                    <long_text/>
                    <unicode_text/>
                    <meta>
                        <instanceID/>
                    </meta>
                </data>
            </instance>
            <bind nodeset="/data/long_text" type="string"/>
            <bind nodeset="/data/unicode_text" type="string"/>
            <bind nodeset="/data/meta/instanceID" type="string" jr:preload="uid"/>
        </model>
    </h:head>
    <h:body>
        <input ref="/data/long_text">
            <label>Long text</label>
        </input>
        <input ref="/data/unicode_text">
            <label>Unicode text</label>
        </input>
    </h:body>
</h:html>
