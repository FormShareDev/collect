<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms"
        xmlns:h="http://www.w3.org/1999/xhtml"
        xmlns:jr="http://openrosa.org/javarosa"
        xmlns:orx="http://openrosa.org/xforms">
    <h:head>
        <h:title>Parity Edge Repeat</h:title>
        <model>
            <instance>
                <data id="parity_edge_repeat" orx:version="1">
                    <rep_count/>
                    <rep jr:template="">
                        <item/>
                    </rep>
                    <colors/>
                    <meta>
                        <instanceID/>
                    </meta>
                </data>
            </instance>
            <bind nodeset="/data/rep_count" type="int"/>
            <bind nodeset="/data/rep/item" type="string"
                  constraint="string-length(.) &lt;= 10"
                  jr:constraintMsg="Max 10 characters"/>
            <bind nodeset="/data/colors" type="string"/>
            <bind nodeset="/data/meta/instanceID" type="string" jr:preload="uid"/>
        </model>
    </h:head>
    <h:body>
        <input ref="/data/rep_count">
            <label>How many items?</label>
        </input>
        <group ref="/data/rep">
            <label>Items</label>
            <repeat nodeset="/data/rep" jr:count="/data/rep_count">
                <input ref="/data/rep/item">
                    <label>Item value</label>
                </input>
            </repeat>
        </group>
        <select ref="/data/colors">
            <label>Pick colours</label>
            <item><label>Red</label><value>red</value></item>
            <item><label>Green</label><value>green</value></item>
            <item><label>Blue</label><value>blue</value></item>
        </select>
    </h:body>
</h:html>
