eset="instance('job_titles')/root/item[category= /data/g_cascade/job_category ]"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/g_rank"><label>8. Rank</label><odk:rank ref="/data/g_rank/rank_widget"><label>Drag to rank A-D</label><itemset nodeset="instance('opt_abcd')/root/item"><value ref="name"/><label ref="label"/></itemset></odk:rank></group><group ref="/data/g_range"><label>9. Range widgets</label><range ref="/data/g_range/rng_h" start="1" end="10" step="1"><label>Horizontal integer range</label></range><range ref="/data/g_range/rng_v" appearance="vertical" start="1" end="10" step="1"><label>Vertical</label></range><range ref="/data/g_range/rng_noticks" appearance="no-ticks" start="1" end="10" step="1"><label>No ticks</label></range><range ref="/data/g_range/rng_picker" appearance="picker" start="1" end="10" step="1"><label>Picker</label></range><range ref="/data/g_range/rng_dec" start="1.5" end="5.5" step="0.5"><label>Decimal range</label></range><range ref="/data/g_range/rng_rating" appearance="rating" start="0" end="5" step="1"><label>Star rating</label></range></group><group ref="/data/g_geo"><label>10. Geospatial widgets</label><input ref="/data/g_geo/geo_point"><label>Geopoint</label></input><input ref="/data/g_geo/geo_point_maps" appearance="maps"><label>Geopoint with map</label></input><input ref="/data/g_geo/geo_point_place" appearance="placement-map"><label>Geopoint placement-map</label></input><input ref="/data/g_geo/geo_trace"><label>Geotrace</label></input><input ref="/data/g_geo/geo_shape"><label>Geoshape</label></input></group><group ref="/data/g_media"><label>11. Media widgets</label><upload ref="/data/g_media/img_default" mediatype="image/*"><label>Image</label></upload><upload ref="/data/g_media/img_annotate" mediatype="image/*" appearance="annotate"><label>Image annotate</label></upload><upload ref="/data/g_media/img_draw" mediatype="image/*" appearance="draw"><label>Draw</label></upload><upload ref="/data/g_media/img_signature" mediatype="image/*" appearance="signature"><label>Signature</label></upload><upload ref="/data/g_media/img_new" mediatype="image/*" appearance="new"><label>Image, camera only</label></upload><upload ref="/data/g_media/img_selfie" mediatype="image/*" appearance="new-front"><label>Selfie</label></upload><upload ref="/data/g_media/img_maxpixels" mediatype="image/*"><label>Image scaled down</label></upload><upload ref="/data/g_media/aud_default" mediatype="audio/*"><label>Audio</label></upload><upload ref="/data/g_media/aud_voice" mediatype="audio/*"><label>Audio voice-only</label></upload><upload ref="/data/g_media/vid_default" mediatype="video/*"><label>Video</label></upload><upload ref="/data/g_media/file_default" mediatype="application/*"><label>File upload</label></upload></group><group ref="/data/g_other"><label>12. Other widgets</label><input ref="/data/g_other/bc_default"><label>Barcode / QR scan</label></input><input ref="/data/g_other/note_default"><label>This is a note.</label></input><trigger ref="/data/g_other/trig_default"><label>Acknowledge to continue</label></trigger><trigger ref="/data/g_other/ack_default"><label>Acknowledge widget</label></trigger></group><group ref="/data/g_logic"><label>13. Logic columns</label><select1 ref="/data/g_logic/has_kids"><label>Do you have children?</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/g_logic/num_kids"><label>How many children?</label></input><input ref="/data/g_logic/txt_static_default"><label>Static default</label></input><input ref="/data/g_logic/date_dyn_default"><label>Defaults to today</label></input><input ref="/data/g_logic/ro_calc"><label>Read-only calculated (kids x 2)</label></input><input ref="/data/g_logic/current_age"><label>Current age</label><setvalue ref="/data/g_logic/diagnosis_age" event="xforms-value-changed" value=" /data/g_logic/current_age "/></input><input ref="/data/g_logic/diagnosis_age"><label>Age at diagnosis (trigger default)</label></input><input ref="/data/g_logic/guided_q"><label>Guidance hint demo</label><hint ref="jr:itext('/data/g_logic/guided_q:hint')"/></input></group><input ref="/data/rep_count"><label>People count</label></input><group ref="/data/people"><label>Person</label><repeat nodeset="/data/people" jr:count=" /data/rep_count "><input ref="/data/people/p_name"><label>Name</label></input><input ref="/data/people/p_age"><label> Age of <output value=" ../p_name "/> </label></input><group ref="/data/people/p_phones"><label> Phone for <output value=" ../p_name "/> </label><repeat nodeset="/data/people/p_phones"><input ref="/data/people/p_phones/phone_num" appearance="numbers"><label>Phone</label></input></repeat></group></repeat></group><group ref="/data/agg_rep"><label>Aggregate source</label><repeat nodeset="/data/agg_rep" jr:count=" /data/agg_rep_count "/></group><group appearance="field-list" ref="/data/g_in"><label>15. Test inputs (fixed defaults)</label><input ref="/data/g_in/in_text"><label>Text</label></input><input ref="/data/g_in/in_int"><label>Integer</label></input><input ref="/data/g_in/in_dec"><label>Decimal</label></input><select1 ref="/data/g_in/in_yn"><label>Yes/No</label><itemset nodeset="instance('yes_no')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select ref="/data/g_in/in_multi"><label>Multi-select</label><itemset nodeset="instance('opt_abcd')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/g_in/in_date"><label>Date</label></input><input ref="/data/g_in/cur_id"><label>City id to look up</label></input></group><group ref="/data/g_ops"><label>16. Operators</label></group><group ref="/data/g_fn"><label>17. Functions (deterministic)</label></group><group ref="/data/g_nd"><label>18. Non-deterministic (exclude from value diff)</label></group></h:body></h:html>