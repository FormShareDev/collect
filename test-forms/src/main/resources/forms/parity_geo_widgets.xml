<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms"
        xmlns:h="http://www.w3.org/1999/xhtml"
        xmlns:jr="http://openrosa.org/javarosa"
        xmlns:orx="http://openrosa.org/xforms">
    <h:head>
        <h:title>Parity Geo Widgets</h:title>
        <model>
            <instance>
                <data id="parity_geo_widgets" orx:version="1">
                    <intro/>
                    <gp>38.25 -77.0 0 0</gp>
                    <gt>38.25 -77.0 0 0; 38.26 -77.0 0 0</gt>
                    <gs>38.25 -77.0 0 0; 38.25 -77.01 0 0; 38.26 -77.01 0 0; 38.25 -77.0 0 0</gs>
                    <meta>
                        <instanceID/>
                    </meta>
                </data>
            </instance>
            <bind nodeset="/data/intro" type="string"/>
            <bind nodeset="/data/gp" type="geopoint"/>
            <bind nodeset="/data/gt" type="geotrace"/>
            <bind nodeset="/data/gs" type="geoshape"/>
            <bind nodeset="/data/meta/instanceID" type="string" jr:preload="uid"/>
        </model>
    </h:head>
    <h:body>
        <input ref="/data/intro"><label>Intro</label></input>
        <input ref="/data/gp"><label>Geopoint</label></input>
        <input ref="/data/gt"><label>Geotrace</label></input>
        <input ref="/data/gs"><label>Geoshape</label></input>
    </h:body>
</h:html>
