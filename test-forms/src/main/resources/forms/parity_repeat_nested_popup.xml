<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms"
        xmlns:h="http://www.w3.org/1999/xhtml"
        xmlns:jr="http://openrosa.org/javarosa"
        xmlns:orx="http://openrosa.org/xforms">
    <h:head>
        <h:title>Parity Repeat Nested Popup</h:title>
        <model>
            <instance>
                <data id="parity_repeat_nested_popup" orx:version="1">
                    <intro/>
                    <r1 jr:template="">
                        <q1a/>
                        <r2 jr:template="">
                            <q2a/>
                            <r3 jr:template="">
                                <q3a/>
                                <r4 jr:template="">
                                    <q4a/>
                                </r4>
                                <q3b/>
                            </r3>
                            <q2b/>
                        </r2>
                        <q1b/>
                    </r1>
                    <final/>
                    <meta>
                        <instanceID/>
                    </meta>
                </data>
            </instance>
            <bind nodeset="/data/intro" type="string"/>
            <bind nodeset="/data/r1/q1a" type="string"/>
            <bind nodeset="/data/r1/r2/q2a" type="string"/>
            <bind nodeset="/data/r1/r2/r3/q3a" type="string"/>
            <bind nodeset="/data/r1/r2/r3/r4/q4a" type="string"/>
            <bind nodeset="/data/r1/r2/r3/q3b" type="string"/>
            <bind nodeset="/data/r1/r2/q2b" type="string"/>
            <bind nodeset="/data/r1/q1b" type="string"/>
            <bind nodeset="/data/final" type="string"/>
            <bind nodeset="/data/meta/instanceID" type="string" jr:preload="uid"/>
        </model>
    </h:head>
    <h:body>
        <input ref="/data/intro"><label>Intro</label></input>
        <group ref="/data/r1">
            <label>R1</label>
            <repeat nodeset="/data/r1">
                <input ref="/data/r1/q1a"><label>Q1a</label></input>
                <group ref="/data/r1/r2">
                    <label>R2</label>
                    <repeat nodeset="/data/r1/r2">
                        <input ref="/data/r1/r2/q2a"><label>Q2a</label></input>
                        <group ref="/data/r1/r2/r3">
                            <label>R3</label>
                            <repeat nodeset="/data/r1/r2/r3">
                                <input ref="/data/r1/r2/r3/q3a"><label>Q3a</label></input>
                                <group ref="/data/r1/r2/r3/r4">
                                    <label>R4</label>
                                    <repeat nodeset="/data/r1/r2/r3/r4">
                                        <input ref="/data/r1/r2/r3/r4/q4a"><label>Q4a</label></input>
                                    </repeat>
                                </group>
                                <input ref="/data/r1/r2/r3/q3b"><label>Q3b</label></input>
                            </repeat>
                        </group>
                        <input ref="/data/r1/r2/q2b"><label>Q2b</label></input>
                    </repeat>
                </group>
                <input ref="/data/r1/q1b"><label>Q1b</label></input>
            </repeat>
        </group>
        <input ref="/data/final"><label>Final</label></input>
    </h:body>
</h:html>
