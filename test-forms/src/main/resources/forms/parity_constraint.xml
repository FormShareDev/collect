<?xml version="1.0" encoding="UTF-8"?>
<h:html xmlns="http://www.w3.org/2002/xforms"
        xmlns:h="http://www.w3.org/1999/xhtml"
        xmlns:jr="http://openrosa.org/javarosa"
        xmlns:orx="http://openrosa.org/xforms">
    <h:head>
        <h:title>Parity Constraint</h:title>
        <model>
            <instance>
                <data id="parity_constraint" orx:version="1">
                    <age/>
                    <name/>
                    <comment/>
                    <meta>
                        <instanceID/>
                    </meta>
                </data>
            </instance>
            <bind nodeset="/data/age" type="int"
                  constraint=". &gt;= 0 and . &lt;= 120"
                  jr:constraintMsg="Age must be 0-120"/>
            <bind nodeset="/data/name" type="string" required="true()"
                  jr:requiredMsg="Name is required"/>
            <bind nodeset="/data/comment" type="string"/>
            <bind nodeset="/data/meta/instanceID" type="string" jr:preload="uid"/>
        </model>
    </h:head>
    <h:body>
        <input ref="/data/age">
            <label>Age</label>
        </input>
        <input ref="/data/name">
            <label>Name</label>
        </input>
        <input ref="/data/comment">
            <label>Comment</label>
        </input>
    </h:body>
</h:html>
